// ──────────────────────────────────────────────────────────────
// Config loader – Loads civetman.config files (js/ts/json)
// ──────────────────────────────────────────────────────────────

path from "node:path"
fs from "fs-extra"
vm from "node:vm"
{ pathToFileURL } from "node:url"
import type { CivetmanConfig } from "../types.civet"
{ findConfig as findCivetConfig, loadConfig as loadCivetConfig } from "@danielx/civet/config"

// Try to locate civetman config in cwd
export findCivetmanConfigPath := async (cwd: string): Promise<string | null> =>
    base := path.resolve(cwd)
    candidates := [
        "civetman.config.js",
        "civetman.config.ts",
        "civetman.config.json",
    ]
    for name of candidates
        full := path.join(base, name)
        if await fs.pathExists(full) return full
    return null

loadJsConfig := async (file: string): Promise<CivetmanConfig> =>
    url := pathToFileURL(file).href
    mod := await import(url)
    mod?.default ?? mod

loadJsonConfig := async (file: string): Promise<CivetmanConfig> =>
    content := await fs.readFile(file, "utf8")
    JSON.parse(content)

// Minimal TS loader: executes an object-literal style default export in a VM
// This is intentionally narrow: supports `export default { ... }` configs.
loadTsConfig := async (file: string): Promise<CivetmanConfig> =>
    source := await fs.readFile(file, "utf8")
    // Extract after `export default`
    idx := source.indexOf("export default")
    if idx === -1
        throw new Error("civetman.config.ts must use `export default { ... }`")
    snippet := source.slice(idx + "export default".length)
    wrapped := `(${snippet})`
    sandbox: Record<string, unknown> := { process, __dirname: path.dirname(file), __filename: file }
    result := vm.runInNewContext(wrapped, sandbox, { filename: file })
    result as CivetmanConfig

export loadCivetmanConfig := async (cwd: string): Promise<{ path: string | null, config: CivetmanConfig | null }> =>
    file := await findCivetmanConfigPath(cwd)
    unless file return { path: null, config: null }
    if file.endsWith(".js") return { path: file, config: await loadJsConfig(file) }
    if file.endsWith(".json") return { path: file, config: await loadJsonConfig(file) }
    if file.endsWith(".ts") return { path: file, config: await loadTsConfig(file) }
    return { path: file, config: null }

export loadBaseCivetCompileOptions := async (cwd: string) =>
    cfgPath := await findCivetConfig(cwd)
    unless cfgPath return {}
    await loadCivetConfig(cfgPath)

